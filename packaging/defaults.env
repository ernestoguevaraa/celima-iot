# Default environment for iot-celima-mqtt service
# Override with: sudo systemctl edit iot-celima-mqtt
MQTT_BROKER="tcp://localhost:1883"
MQTT_CLIENT_ID="celima-integration"
ISA95_PREFIX="celima/punta_hermosa/planta/linea/"
# Número de turnos: 2 (6am-6pm / 6pm-6am) o 3 (turnos de 8h)
SHIFT_MODE=2

# Tasas máximas por línea/máquina para la cota de plausibilidad escalada.
# Si falta o no parsea, el servicio arranca igual y usa default_rate_per_h.
CELIMA_RATES_CONFIG="/etc/iot-celima-mqtt/rates.json"

# Persistencia del estado de turno (SQLite). El directorio lo crea systemd via
# StateDirectory=. Poner CELIMA_STATE_PERSISTENCE=0 desactiva carga y guardado:
# es el interruptor para revertir en planta sin recompilar ni redesplegar.
CELIMA_STATE_DB="/var/lib/iot-celima-mqtt/state.db"
CELIMA_STATE_PERSISTENCE=1
# Hueco por encima del cual la restauración lo registra y marca el turno.
# 5x el intervalo normal de 180 s. Valor a revisar con datos de planta.
CELIMA_GAP_SHORT_S=900
